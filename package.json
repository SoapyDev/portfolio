    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
